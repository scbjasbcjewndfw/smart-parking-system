# 复制为 .env 后按实际情况修改；.env 不要提交到版本库
# 所有变量都有开发默认值，不配置也能启动，但生产环境必须覆盖 JWT 密钥与数据库密码

# JWT 签名密钥。生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
CARPARK_JWT_SECRET=

# 登录凭证有效期（分钟）
CARPARK_JWT_EXPIRES_MIN=120

# 允许跨域的前端地址，逗号分隔。部署到正式域名后务必收窄
CARPARK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 单次上传大小上限（MB），需与前端提示保持一致
CARPARK_MAX_UPLOAD_MB=10

# ===== 数据库 =====
# 后端类型：mysql（默认）或 sqlite
CARPARK_DB_BACKEND=mysql

# 方式一：直接给完整连接串（设置后忽略下面的分项配置）
# CARPARK_DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/parking_db?charset=utf8mb4

# 方式二：MySQL 分项配置
CARPARK_DB_HOST=127.0.0.1
CARPARK_DB_PORT=3306
CARPARK_DB_USER=root
CARPARK_DB_PASSWORD=
CARPARK_DB_NAME=parking_db
CARPARK_DB_CHARSET=utf8mb4

# 方式三：SQLite（CARPARK_DB_BACKEND=sqlite 时生效），默认 instance/parking.db
# CARPARK_DB_PATH=instance/parking.db

# 设为 1 打印 SQL，排查问题时使用
CARPARK_DB_ECHO=0
